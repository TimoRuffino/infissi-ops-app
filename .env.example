# Runtime
NODE_ENV=development
DATABASE_URL=
PORT=3000

# Secrets at rest (generate with: openssl rand -base64 48)
MAIL_ENCRYPTION_KEY=

# Durable file storage. Cloudflare R2 uses STORAGE_DRIVER=s3 and S3_REGION=auto.
STORAGE_DRIVER=local
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=ruffino-crm-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# First boot only. Required when the utenti store is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@ruffinogroup.it
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_SURNAME=Ruffino

# Google Drive backup OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Fatture in Cloud OAuth
FIC_OAUTH_CLIENT_ID=
FIC_OAUTH_CLIENT_SECRET=
FIC_OAUTH_REDIRECT_URI=

# Riservata al futuro agente: oggi nessun modulo attivo la consuma
# (l'agente è stato rimosso il 28/08/2026, docs/tars-rimosso-2026-08-28.md).
OPENAI_API_KEY=

# Centro Azioni: legacy | shadow | active.
# Tenere shadow fino al confronto dei log produzione.
ACTION_CENTER_MODE=shadow

# Optional Umami analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ── Kill switch Document Intelligence (release hardening 29/08/2026) ──────
# Default FAIL-CLOSED: attivi solo con NODE_ENV=development/test; in
# produzione restano spenti finché non li accendi esplicitamente.
# Rollout progressivo: docs/runbooks/rollout-document-intelligence.md
# FLAG_DOCUMENT_INTELLIGENCE=on
# FLAG_PROPOSTE=on
# FLAG_OCR=on
# Lingue OCR (default ita+eng; deu già installato nell'immagine)
# OCR_LINGUE=ita+eng

# Contratto strutturato e computo limiti (piano 1, 03/09/2026): fail-closed, spento in produzione finché la direzione non lo apre per una sede di prova
# FLAG_LIMITI=off

# Fatturazione dal contratto (piano 2, 04/09/2026): fail-closed come FLAG_LIMITI
# FLAG_FATTURAZIONE=off
# Invio SdI in prova: acceso finché non vale «off» (prima fattura reale col commercialista)
# FATTURAZIONE_SDI_DRY_RUN=on
