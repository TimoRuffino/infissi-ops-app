# Runtime
NODE_ENV=development
DATABASE_URL=
PORT=3000

# Secrets at rest (generate with: openssl rand -base64 48)
MAIL_ENCRYPTION_KEY=

# Durable file storage. Cloudflare R2 uses STORAGE_DRIVER=s3 and S3_REGION=auto.
STORAGE_DRIVER=local
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=ruffino-crm-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# First boot only. Required when the utenti store is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@ruffinogroup.it
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_SURNAME=Ruffino

# Google Drive backup OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Fatture in Cloud OAuth
FIC_OAUTH_CLIENT_ID=
FIC_OAUTH_CLIENT_SECRET=
FIC_OAUTH_REDIRECT_URI=

# Tars
OPENAI_API_KEY=
# legacy | shadow | active. Tenere shadow fino al confronto dei log produzione.
ACTION_CENTER_MODE=shadow

# Optional Umami analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
