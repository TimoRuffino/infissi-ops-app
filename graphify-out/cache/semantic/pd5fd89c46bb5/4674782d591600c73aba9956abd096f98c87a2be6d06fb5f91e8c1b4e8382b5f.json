{"nodes": [{"id": "agente_ruffino_ops_tars", "label": "Tars Operational Agent", "file_type": "document", "source_file": "Agente_Ruffino_Ops.md", "source_location": "title and implementation status", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null}, {"id": "agente_ruffino_ops_deterministic_pipeline", "label": "Deterministic Reflex Pipeline", "file_type": "rationale", "source_file": "Agente_Ruffino_Ops.md", "source_location": "section 1", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null, "rationale": "Simple high-volume classification belongs in a cheap, fast, testable pipeline rather than an expensive agent loop."}, {"id": "agente_ruffino_ops_agentic_reasoning_loop", "label": "Tool-using Agentic Reasoning Loop", "file_type": "rationale", "source_file": "Agente_Ruffino_Ops.md", "source_location": "sections 1 and 3", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null, "rationale": "Ambiguous reconciliation and contradiction resolution require iterative search, backtracking, and changing hypotheses."}, {"id": "agente_ruffino_ops_propose_not_execute", "label": "Capability-level Propose-not-execute Pattern", "file_type": "rationale", "source_file": "Agente_Ruffino_Ops.md", "source_location": "section 2", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null, "rationale": "Safety is enforced by omitting write tools, not by asking the model to remember a policy; even a compromised model can only create a reviewable proposal."}, {"id": "agente_ruffino_ops_company_memory", "label": "Company Memory Store", "file_type": "rationale", "source_file": "Agente_Ruffino_Ops.md", "source_location": "sections 3 and 8", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null, "rationale": "Curated company knowledge captures conventions and preferences that prompt tuning alone cannot reliably supply; it is written by management and never inferred by the agent."}, {"id": "agente_ruffino_ops_proposal_queue", "label": "Suggested Actions Queue", "file_type": "concept", "source_file": "Agente_Ruffino_Ops.md", "source_location": "sections 3 and 7", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null}, {"id": "agente_ruffino_ops_tool_profiles", "label": "Trigger-specific Tool Profiles", "file_type": "rationale", "source_file": "Agente_Ruffino_Ops.md", "source_location": "section 4.4", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null, "rationale": "Stable minimal tool catalogs reduce latency and token cost while improving tool selection."}, {"id": "agente_ruffino_ops_commessa_dossier_preload", "label": "Commessa Dossier Preload", "file_type": "rationale", "source_file": "Agente_Ruffino_Ops.md", "source_location": "section 4.4", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null, "rationale": "Aggregating and preloading the known commessa context avoids reconstructing the same facts through many tool calls and removes an initial model-tool round trip."}, {"id": "agente_ruffino_ops_per_run_tool_cache", "label": "Per-run Tool Cache", "file_type": "rationale", "source_file": "Agente_Ruffino_Ops.md", "source_location": "sections 4.4 and 10.1", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null, "rationale": "Caching is isolated to one execution to deduplicate reads without leaking stale or cross-context data between users or runs."}, {"id": "agente_ruffino_ops_anthropic_prompt_caching", "label": "Anthropic Prompt Caching", "file_type": "concept", "source_file": "Agente_Ruffino_Ops.md", "source_location": "section 10.1", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null}, {"id": "agente_ruffino_ops_human_clarification", "label": "Actionable Human Clarification", "file_type": "rationale", "source_file": "Agente_Ruffino_Ops.md", "source_location": "section 4.3", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null, "rationale": "An agent that can explicitly ask for missing information is less likely to invent data or produce low-confidence actions."}, {"id": "agente_ruffino_ops_explicit_no_action", "label": "Explicit No-action Termination", "file_type": "rationale", "source_file": "Agente_Ruffino_Ops.md", "source_location": "section 4.3", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null, "rationale": "Making no action a legitimate tool response reduces the pressure to produce noisy proposals merely to appear useful."}, {"id": "agente_ruffino_ops_prompt_injection_defense", "label": "Layered Prompt Injection Defense", "file_type": "rationale", "source_file": "Agente_Ruffino_Ops.md", "source_location": "section 9.1", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null, "rationale": "Defense combines no write capability, explicit untrusted-content delimiters, code-enforced site scope, and mandatory escalation of manipulation attempts."}, {"id": "agente_ruffino_ops_process_audit", "label": "Continuous Process Audit", "file_type": "rationale", "source_file": "Agente_Ruffino_Ops.md", "source_location": "section 5", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null, "rationale": "Audits should react to measurable recurring patterns rather than isolated cases and must only propose bounded improvements."}, {"id": "agente_ruffino_ops_action_deduplication", "label": "Canonical Action Deduplication", "file_type": "rationale", "source_file": "Agente_Ruffino_Ops.md", "source_location": "implementation status and section 5", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null, "rationale": "Canonical action keys and title similarity stop reworded versions of already pending or decided actions from returning to the queue."}, {"id": "agente_ruffino_ops_email_source", "label": "Email IMAP Source", "file_type": "concept", "source_file": "Agente_Ruffino_Ops.md", "source_location": "section 6.1", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null}, {"id": "agente_ruffino_ops_whatsapp_source", "label": "WhatsApp Cloud API Source", "file_type": "concept", "source_file": "Agente_Ruffino_Ops.md", "source_location": "section 6.2", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null}, {"id": "agente_ruffino_ops_fic_read_only_source", "label": "Read-only Fatture in Cloud Source", "file_type": "concept", "source_file": "Agente_Ruffino_Ops.md", "source_location": "section 6.3", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null}, {"id": "agente_ruffino_ops_commessa_documents_source", "label": "Commessa Document Source", "file_type": "concept", "source_file": "Agente_Ruffino_Ops.md", "source_location": "section 6.4", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null}, {"id": "agente_ruffino_ops_proposal_approval_rate", "label": "Proposal Approval Rate", "file_type": "rationale", "source_file": "Agente_Ruffino_Ops.md", "source_location": "section 14", "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null, "rationale": "Approval rate by action type is the primary quality signal because it directly measures whether proposals are useful rather than noisy."}], "edges": [{"source": "agente_ruffino_ops_tars", "target": "agente_ruffino_ops_deterministic_pipeline", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Agente_Ruffino_Ops.md", "source_location": "principle and section 1", "weight": 1.0}, {"source": "agente_ruffino_ops_tars", "target": "agente_ruffino_ops_agentic_reasoning_loop", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Agente_Ruffino_Ops.md", "so